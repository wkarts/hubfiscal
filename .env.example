COMPOSE_PROJECT_NAME=hubfiscal
HUBFISCAL_ENV=development
HUBFISCAL_DEBUG=true
HUBFISCAL_API_URL=http://localhost:8080
HUBFISCAL_WEB_URL=http://localhost:3000
HUBFISCAL_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
HUBFISCAL_SECRET_KEY=change-me-with-at-least-64-random-characters
HUBFISCAL_ENCRYPTION_KEY=change-me-base64-fernet-key
HUBFISCAL_BOOTSTRAP_TOKEN=change-me-first-admin-bootstrap-token
HUBFISCAL_ACCESS_TOKEN_MINUTES=60
HUBFISCAL_REFRESH_TOKEN_DAYS=30
HUBFISCAL_LOG_LEVEL=INFO
HUBFISCAL_BUILD_SHA=development
HUBFISCAL_BUILD_DATE=unknown
HUBFISCAL_BUILD_REF=local

POSTGRES_DB=hubfiscal
POSTGRES_USER=hubfiscal
POSTGRES_PASSWORD=hubfiscal-change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://hubfiscal:hubfiscal-change-me@hubfiscal-postgres:5432/hubfiscal
DATABASE_URL_SYNC=postgresql+psycopg://hubfiscal:hubfiscal-change-me@hubfiscal-postgres:5432/hubfiscal

REDIS_URL=redis://hubfiscal-redis:6379/0
RABBITMQ_DEFAULT_USER=hubfiscal
RABBITMQ_DEFAULT_PASS=hubfiscal-change-me
RABBITMQ_URL=amqp://hubfiscal:hubfiscal-change-me@hubfiscal-rabbitmq:5672//
CELERY_BROKER_URL=amqp://hubfiscal:hubfiscal-change-me@hubfiscal-rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://hubfiscal-redis:6379/1

MINIO_ROOT_USER=hubfiscal
MINIO_ROOT_PASSWORD=hubfiscal-change-me
MINIO_ENDPOINT=http://hubfiscal-minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET=hubfiscal-documents
MINIO_REGION=us-east-1
MINIO_SECURE=false

VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME=Hub Fiscal
VITE_APP_VERSION=0.2.0
VITE_BUILD_SHA=development
VITE_BUILD_DATE=unknown

# Produção / GHCR
GHCR_REGISTRY=ghcr.io
GHCR_NAMESPACE=wkarts
HUBFISCAL_IMAGE_TAG=0.2.0
HUBFISCAL_API_BASE_TAG=py3.13-v1
HUBFISCAL_WEB_BASE_TAG=node24-v1

# Persistência física para CloudPanel/Dockge
HUBFISCAL_DATA_ROOT=/opt/hubfiscal
