# Hub Fiscal — desenvolvimento local
COMPOSE_PROJECT_NAME=hubfiscal-dev
INSTANCE_NAME=development
RESOURCE_PREFIX=hubfiscal-dev

APP_NAME="Hub Fiscal"
APP_TIMEZONE=America/Bahia
HUBFISCAL_ENV=development
HUBFISCAL_DEBUG=true
HUBFISCAL_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
HUBFISCAL_SECRET_KEY=change-me-with-at-least-64-random-characters
HUBFISCAL_ENCRYPTION_KEY=change-me-fernet-key
HUBFISCAL_BOOTSTRAP_TOKEN=change-me-first-admin-bootstrap-token
HUBFISCAL_ACCESS_TOKEN_MINUTES=60
HUBFISCAL_REFRESH_TOKEN_DAYS=30
HUBFISCAL_LOG_LEVEL=INFO

# Portas locais de desenvolvimento
HUBFISCAL_API_PORT=8080
HUBFISCAL_WEB_PORT=3000
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# PostgreSQL — a aplicação constrói as URLs internamente
POSTGRES_DB=hubfiscal
POSTGRES_USER=hubfiscal
POSTGRES_PASSWORD=change-me-postgres

# Redis
REDIS_DB=0
CELERY_RESULT_REDIS_DB=1

# RabbitMQ
RABBITMQ_USER=hubfiscal
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_VHOST=/
CELERY_CONCURRENCY=2

# MinIO próprio na mesma stack
MINIO_USER=hubfiscal
MINIO_PASSWORD=change-me-minio
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET=hubfiscal-documents
MINIO_REGION=sa-east-1

# Contrato de imagens de produção. `latest` acompanha a última release estável.
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=wkarts
APP_IMAGE_TAG=latest
STORAGE_INIT_IMAGE=alpine:3.22
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:8-alpine
RABBITMQ_IMAGE=rabbitmq:4-management-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
API_RUNTIME_UID=10001
API_RUNTIME_GID=10001
LOG_MAX_SIZE=20m
LOG_MAX_FILES=5

# Frontend em desenvolvimento. Este valor segue VERSION, não APP_IMAGE_TAG.
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME=Hub Fiscal
VITE_APP_VERSION=0.2.3
VITE_BUILD_SHA=development
VITE_BUILD_DATE=unknown
