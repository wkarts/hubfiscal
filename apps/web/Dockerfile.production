ARG WEB_BASE_IMAGE=ghcr.io/wkarts/hubfiscal-web-base:node24-v1
FROM ${WEB_BASE_IMAGE} AS build

ARG APP_VERSION=development
ARG BUILD_SHA=development
ARG BUILD_DATE=unknown
ARG VITE_API_BASE_URL=/api/v1

WORKDIR /app
COPY apps/web ./
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_APP_VERSION=${APP_VERSION} \
    VITE_BUILD_SHA=${BUILD_SHA} \
    VITE_BUILD_DATE=${BUILD_DATE}
RUN npm run build

FROM nginx:1.29-alpine
ARG APP_VERSION=development
ARG BUILD_SHA=development
ARG BUILD_DATE=unknown
LABEL org.opencontainers.image.title="Hub Fiscal Web" \
      org.opencontainers.image.description="Frontend da plataforma Hub Fiscal" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${BUILD_SHA}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="https://github.com/wkarts/hubfiscal"
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -q -O /dev/null http://127.0.0.1/health || exit 1
