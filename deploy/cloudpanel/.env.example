# Hub Fiscal 0.2.2 — Docker/Dockge/Portainer com reverse proxy do CloudPanel
COMPOSE_PROJECT_NAME=hubfiscal
GHCR_REGISTRY=ghcr.io
GHCR_NAMESPACE=wkarts
HUBFISCAL_IMAGE_TAG=0.2.2

# O CloudPanel apenas aponta o proxy reverso para 127.0.0.1:58088
HUBFISCAL_BIND_HOST=127.0.0.1
HUBFISCAL_HTTP_PORT=58088
HUBFISCAL_DOMAIN=hubfiscal.seudominio.com.br
HUBFISCAL_CORS_ORIGINS=https://hubfiscal.seudominio.com.br

# Para Dockge pode ser relativo à pasta da stack.
# Não acrescente comentários ou outras palavras após o valor.
HUBFISCAL_DATA_ROOT=./hubfiscal-data

# MinIO interno na mesma stack. Deixe vazio sem proxy S3 dedicado.
MINIO_PUBLIC_ENDPOINT=

# Aplicação
HUBFISCAL_ENV=production
HUBFISCAL_DEBUG=false
HUBFISCAL_SECRET_KEY=change-me-with-at-least-64-random-characters
HUBFISCAL_ENCRYPTION_KEY=change-me-fernet-key
HUBFISCAL_BOOTSTRAP_TOKEN=change-me-bootstrap-token
HUBFISCAL_ACCESS_TOKEN_MINUTES=60
HUBFISCAL_REFRESH_TOKEN_DAYS=30
HUBFISCAL_LOG_LEVEL=INFO
HUBFISCAL_BUILD_SHA=manual-docker
HUBFISCAL_BUILD_DATE=unknown
HUBFISCAL_BUILD_REF=v0.2.2

# PostgreSQL
POSTGRES_DB=hubfiscal
POSTGRES_USER=hubfiscal
POSTGRES_PASSWORD=change-me-postgres

# RabbitMQ e Celery
RABBITMQ_USER=hubfiscal
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_VHOST=/
CELERY_CONCURRENCY=2

# MinIO próprio, executado nesta mesma stack
MINIO_USER=hubfiscal
MINIO_PASSWORD=change-me-minio
MINIO_BUCKET=hubfiscal-documents
MINIO_REGION=sa-east-1

# Imagens de infraestrutura
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:8-alpine
RABBITMQ_IMAGE=rabbitmq:4-management-alpine
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest

# Logs Docker
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5
