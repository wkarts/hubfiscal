COMPOSE_PROJECT_NAME=hubfiscal
HUBFISCAL_DATA_ROOT=/home/cloudpanel/htdocs/hubfiscal-data
HUBFISCAL_HTTP_PORT=8088
HUBFISCAL_IMAGE_TAG=0.1.0
GHCR_REGISTRY=ghcr.io
GHCR_NAMESPACE=wkarts
HUBFISCAL_CORS_ORIGINS=https://fiscal.seudominio.com.br
HUBFISCAL_SECRET_KEY=change-me
HUBFISCAL_ENCRYPTION_KEY=change-me
HUBFISCAL_BOOTSTRAP_TOKEN=change-me
POSTGRES_DB=hubfiscal
POSTGRES_USER=hubfiscal
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://hubfiscal:change-me@hubfiscal-postgres:5432/hubfiscal
DATABASE_URL_SYNC=postgresql+psycopg://hubfiscal:change-me@hubfiscal-postgres:5432/hubfiscal
REDIS_URL=redis://hubfiscal-redis:6379/0
RABBITMQ_DEFAULT_USER=hubfiscal
RABBITMQ_DEFAULT_PASS=change-me
CELERY_BROKER_URL=amqp://hubfiscal:change-me@hubfiscal-rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://hubfiscal-redis:6379/1
MINIO_ROOT_USER=hubfiscal
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT=http://hubfiscal-minio:9000
MINIO_PUBLIC_ENDPOINT=https://fiscal.seudominio.com.br/storage
MINIO_BUCKET=hubfiscal-documents
MINIO_SECURE=false
