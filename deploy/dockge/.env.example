# Identidade única da instalação. Troque wwsoftwares em outra stack.
COMPOSE_PROJECT_NAME=hubfiscal-wwsoftwares
INSTANCE_NAME=wwsoftwares
RESOURCE_PREFIX=hubfiscal-wwsoftwares

APP_NAME="Hub Fiscal - WWSoftware's"
APP_TIMEZONE=America/Bahia
HUBFISCAL_ENV=production
HUBFISCAL_DEBUG=false
HUBFISCAL_DOMAIN=hubfiscal.wwsoftwares.com.br
HUBFISCAL_CORS_ORIGINS=https://hubfiscal.wwsoftwares.com.br
HUBFISCAL_SECRET_KEY=change-me-with-at-least-64-random-characters
HUBFISCAL_ENCRYPTION_KEY=change-me-fernet-key
HUBFISCAL_BOOTSTRAP_TOKEN=change-me-bootstrap-token
HUBFISCAL_ACCESS_TOKEN_MINUTES=60
HUBFISCAL_REFRESH_TOKEN_DAYS=30
HUBFISCAL_LOG_LEVEL=INFO

# `latest` acompanha a release estável mais recente publicada no GHCR.
# Para rollback ou homologação reprodutível, fixe temporariamente X.Y.Z.
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=wkarts
APP_IMAGE_TAG=latest

# O CloudPanel aponta o reverse proxy para http://127.0.0.1:58088.
WEB_BIND_HOST=127.0.0.1
WEB_PUBLISHED_PORT=58088

# Caminho relativo à pasta da stack no Dockge.
# Não acrescente comentários ou outras palavras após o valor.
HUBFISCAL_DATA_ROOT=./hubfiscal-data

POSTGRES_DB=hubfiscal
POSTGRES_USER=hubfiscal
POSTGRES_PASSWORD=change-me-postgres

RABBITMQ_USER=hubfiscal
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_VHOST=/
CELERY_CONCURRENCY=2

# MinIO próprio, executado nesta mesma stack. O Hub Fiscal cifra certificados
# e outros segredos com HUBFISCAL_ENCRYPTION_KEY antes do upload. Deixe `none`
# no MinIO local; use AES256 somente quando SSE/KMS estiver configurado.
MINIO_USER=hubfiscal
MINIO_PASSWORD=change-me-minio
MINIO_BUCKET=hubfiscal-documents
MINIO_REGION=sa-east-1
MINIO_PUBLIC_ENDPOINT=
MINIO_SERVER_SIDE_ENCRYPTION=none

STORAGE_INIT_IMAGE=alpine:3.22
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:8-alpine
RABBITMQ_IMAGE=rabbitmq:4-management-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
API_RUNTIME_UID=10001
API_RUNTIME_GID=10001

LOG_MAX_SIZE=20m
LOG_MAX_FILES=5
